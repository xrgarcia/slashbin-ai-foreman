{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "code": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason_text": {
      "type": "string",
      "maxLength": 300
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "role": {
      "type": "string",
      "const": "implementer"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "pr-opened",
        "skipped",
        "landed",
        "failed"
      ]
    },
    "pr": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "issues_named": {
      "type": "array",
      "items": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      }
    },
    "skipped_issue": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "waiting_on": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?:[\\w.-]+\\/[\\w.-]+)?#\\d+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "landed_issue": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema",
    "role",
    "outcome"
  ],
  "additionalProperties": {}
}
