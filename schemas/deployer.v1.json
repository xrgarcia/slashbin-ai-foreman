{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "code": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason_text": {
      "type": "string",
      "maxLength": 300
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "role": {
      "type": "string",
      "const": "deployer"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "merged",
        "held",
        "refused",
        "not-run"
      ]
    },
    "pr": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "merged": {
      "type": "boolean"
    },
    "merge_sha": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "verify": {
      "type": "string",
      "enum": [
        "pass",
        "hold",
        "fail",
        "none"
      ]
    },
    "hold": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "hold_class": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "time",
            "person",
            "transient"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "eligible_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "unrelated_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "signature": {
            "type": "string",
            "pattern": "^[a-z0-9._:-]{3,80}$"
          },
          "class": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "text": {
            "type": "string",
            "maxLength": 500
          },
          "first_seen": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "evidence": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "signature"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "schema",
    "role",
    "outcome",
    "pr",
    "merged",
    "verify"
  ],
  "additionalProperties": {}
}
