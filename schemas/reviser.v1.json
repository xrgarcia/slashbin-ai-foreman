{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "code": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason_text": {
      "type": "string",
      "maxLength": 300
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "role": {
      "type": "string",
      "const": "reviser"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "pushed",
        "no-commit",
        "reverted",
        "failed"
      ]
    },
    "changed": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "code",
          "tests",
          "docs",
          "revert"
        ]
      }
    },
    "reverted_findings": {
      "type": "array",
      "items": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      }
    },
    "pr_body_stale": {
      "type": "boolean"
    },
    "head_sha": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema",
    "role",
    "outcome"
  ],
  "additionalProperties": {}
}
