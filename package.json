{
  "name": "slashbin-ai-agent",
  "version": "0.1.0",
  "description": "Open-source daemon that watches GitHub repos for approved issues and implements them using Claude Code CLI",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "slashbin-ai-agent": "dist/cli.js"
  },
  "files": [
    "dist",
    "hooks",
    "skills"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/cli.ts",
    "start": "node agent-manager.mjs start",
    "stop": "node agent-manager.mjs stop",
    "restart": "node agent-manager.mjs restart",
    "status": "node agent-manager.mjs status",
    "logs": "node agent-manager.mjs logs",
    "start:repo": "node agent-manager.mjs start --repo",
    "stop:repo": "node agent-manager.mjs stop --repo",
    "status:repo": "node agent-manager.mjs status --repo",
    "logs:repo": "node agent-manager.mjs logs --repo",
    "start:fg": "node dist/cli.js",
    "once": "node dist/cli.js --once",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "setup": "npm install && npm run build && node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "labels:install": "node scripts/install-labels.mjs",
    "paperclip:register": "node scripts/paperclip/agent.mjs",
    "paperclip:doctor": "node dist/cli.js paperclip:doctor",
    "docs:generate": "node scripts/docs/generate-paperclip.mjs && node scripts/docs/generate-lifecycle.mjs && node scripts/docs/generate-configuration.mjs",
    "docs:check": "node scripts/docs/generate-paperclip.mjs --check && node scripts/docs/generate-lifecycle.mjs --check && node scripts/docs/generate-configuration.mjs --check"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ws": "^8.20.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
