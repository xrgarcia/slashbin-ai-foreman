{
  "repos": [
    {
      "name": "console",
      "repoPath": "../my-console",
      "githubRepo": "your-org/my-console",
      "skillPath": ".claude/skills/implement-approved-issues/SKILL.md",
      "revisionSkillPath": ".claude/skills/revise-pr-feedback/SKILL.md"
    },
    {
      "name": "api",
      "repoPath": "../my-api",
      "githubRepo": "your-org/my-api",
      "skillPath": ".claude/skills/implement-approved-issues/SKILL.md",
      "revisionSkillPath": ".claude/skills/revise-pr-feedback/SKILL.md",
      "_model": "Per-repo override; omit it to inherit the top-level model.",
      "model": "claude-opus-5-5"
    },
    {
      "name": "big-feature-repo",
      "repoPath": "../my-monolith",
      "githubRepo": "your-org/my-monolith",
      "skillPath": ".claude/skills/implement-approved-issues/SKILL.md",
      "revisionSkillPath": ".claude/skills/revise-pr-feedback/SKILL.md",
      "maxTurns": 60,
      "maxDurationMs": 3000000
    }
  ],
  "triggerLabel": "approved",
  "baseBranch": "develop",
  "featureBranch": "features",
  "pollIntervalMs": 300000,
  "maxTurns": 30,
  "maxDurationMs": 1800000,
  "model": "claude-opus-5-5",
  "logFormat": "text",
  "logLevel": "info",
  "_review_phase": "Optional. Enable the Review phase to auto-review feature PRs. Disabled by default. Requires EM_GITHUB_TOKEN in the environment. Per-repo overrides: add reviewEnabled, reviewSkillPath or reviewerLogin to a repos[] entry. emRepoPath is optional; without it the review runs in the repo's review checkout.",
  "reviewEnabled": false,
  "emRepoPath": "../my-review-repo",
  "reviewSkillPath": ".claude/skills/<your-review-skill>/SKILL.md",
  "reviewModel": "claude-opus-5-5",
  "reviewMaxTurns": 200,
  "reviewMaxDurationMs": 3600000,
  "reviewerLogin": "your-reviewer-bot-login"
}
